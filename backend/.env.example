# Copier en backend/.env et adapter. Ne jamais committer le fichier .env.
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Origines autorisées quand DEBUG=0 (séparées par des virgules)
DJANGO_CORS_ORIGINS=
# Chemin du fichier SQLite (optionnel, défaut : backend/db.sqlite3)
DJANGO_DB_PATH=
# Production : origine(s) publique(s) de l'application, ex. https://garage.example.ma
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 en production (HTTPS) : cookies Secure
DJANGO_COOKIE_SECURE=
# Durées de session
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Verrouillage après échecs de connexion
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
